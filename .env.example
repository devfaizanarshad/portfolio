# Public URL of the deployed site (used for canonical/Open Graph links).
NEXT_PUBLIC_SITE_URL=https://faizanarshad.com

# ---------------------------------------------------------------------------
# Project inquiry delivery (/api/inquiry)
# Copy this file to .env.local and fill in at least one channel. With neither
# set, the form still works: it opens the visitor's email app with their
# message pre-filled. Never commit real keys.
# ---------------------------------------------------------------------------

# Option A — email via Resend (https://resend.com). Verify your sending domain first.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=you@example.com
INQUIRY_FROM_EMAIL="Portfolio Inquiries <inquiries@your-verified-domain.com>"

# Option B — POST each inquiry as JSON to a webhook (n8n, Make, Zapier, Slack…).
INQUIRY_WEBHOOK_URL=
# Optional shared secret, sent as the X-Webhook-Secret header.
INQUIRY_WEBHOOK_SECRET=
